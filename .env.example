# Copy to .env (or <name>.env for a second runner set) and fill in. It holds a
# token, so keep it private: install -m 600 .env.example .env
# Switches take true or false; anything else stops the container.

# Where the runners register (https only):
#   https://github.com/<owner>/<repo>          repository (the only option for personal accounts)
#   https://github.com/<org>                   organization
#   https://github.com/enterprises/<name>      enterprise
GITHUB_URL=https://github.com/<owner>/<repo>

# Token the container uses to fetch short-lived registration and removal tokens.
# Fine-grained PAT, limited to the repositories or organization above:
#   repository runners:   Repository permissions → Administration: Read and write
#   organization runners: Organization permissions → Self-hosted runners: Read and write
# Classic PAT: "repo" (repository), "admin:org" (organization),
# "manage_runners:enterprise" (enterprise). See README → Security.
ACCESS_TOKEN=
# Or read it from a file mounted into the container (README → Token from a file).
# ACCESS_TOKEN_FILE=/run/secrets/access_token

# Alternative without a PAT: a registration token from
# Settings → Actions → Runners → New self-hosted runner. It expires after an
# hour, so the runner cannot deregister on stop and an ephemeral runner cannot
# register again after its job.
# RUNNER_TOKEN=
# RUNNER_TOKEN_FILE=

# Extra labels, comma-separated. "self-hosted", the OS ("Linux") and the
# architecture ("X64"/"ARM64") are always added unless NO_DEFAULT_LABELS=true.
RUNNER_LABELS=containerized
# NO_DEFAULT_LABELS=false

# Only for persistent runners with an external host controller. Preserve an
# absolute work directory on container stop; the controller owns its cleanup.
# CLEAN_WORKDIR_ON_EXIT=true

# Runners are named <prefix>-<container id>. A fixed RUNNER_NAME only works for
# a single replica.
RUNNER_NAME_PREFIX=docker
# RUNNER_NAME=

# Runner group (organizations and enterprises only).
# RUNNER_GROUP=

# true: every runner takes one job, deregisters and starts again with an empty
# work directory. With "docker compose up" it is the same container, so a job can
# still affect later ones; the systemd unit gives every job a new container.
# false: runners stay registered and keep their work directory.
EPHEMERAL=true

# Limits per runner container.
RUNNER_CPUS=2
RUNNER_MEMORY=4g

# Image to run. CI publishes it for amd64 and arm64; "docker compose pull" fetches
# it. Pin a tag to roll back, or leave it on latest.
# RUNNER_IMAGE=ghcr.io/franzgollhammer/ci-runner:latest

# apt packages on top of the baseline (browser libraries, xvfb, build-essential,
# gh, shellcheck, ...; see README → Image baseline), space-separated. Only for a
# local build (docker compose up --build); the published image ignores it.
# EXTRA_APT_PACKAGES="redis-server"

# Docker in jobs (root on the host, see README): switch this set to
# compose.docker.yml. Add :compose.override.yaml when you mount a token file.
# COMPOSE_FILE=compose.yaml:compose.docker.yml
# Group id of /var/run/docker.sock on the host:
#   Linux:          stat -c %g /var/run/docker.sock
#   Docker Desktop: docker run --rm -v /var/run/docker.sock:/s alpine stat -c %g /s
# DOCKER_GID=
# The only labels of these runners (no RUNNER_LABELS, no defaults), and their
# work directory. Jobs ask for them with runs-on: docker.
# RUNNER_DOCKER_LABELS=docker
# RUNNER_DOCKER_WORKDIR=/var/lib/actions-runner/<compose project>
