[Unit]
Description=Recover a stopped UCSL runner or interrupted nightly refresh
Wants=network-online.target
Requires=docker.service user@1001.service
After=network-online.target docker.service user@1001.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ci-host recover
TimeoutStartSec=infinity
UMask=0077
